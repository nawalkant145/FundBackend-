# ─── Server ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────
MONGODB_URI=mongodb://localhost:27017/expglofund

# ─── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS — Allowed Origins (comma separated) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Cloudinary (Week 2) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Upstash Redis (Week 4) ───────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Resend Email (Week 1 — OTP) ──────────
RESEND_API_KEY=

# ─── MSG91 — Phone OTP (Week 1) ───────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
ENABLE_DUMMY_OTP=true

# ─── Firebase FCM (Week 8) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Razorpay (Week 7) ────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── WebRTC TURN — Metered.ca (Week 6) ────
METERED_USERNAME=
METERED_CREDENTIAL=

# ─── Cookies ──────────────────────────────
COOKIE_SECRET=replace_with_random_string
